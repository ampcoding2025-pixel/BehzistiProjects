NEXT_PUBLIC_API_BASE_URL=http://localhost:5088

# Chat agent (OpenAI-compatible). Keep secrets server-side only — never NEXT_PUBLIC_.
# Examples:
# OpenAI:   LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# Groq:     LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter free models: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=openrouter/free
LLM_API_KEY=REPLACE_WITH_OPENROUTER_KEY
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_HTTP_REFERER=http://localhost:3001
LLM_APP_TITLE=Didban Management Dashboard

# Leave empty to use same-origin /api/chat (OpenRouter). Set only for external bot.
NEXT_PUBLIC_SUPPORT_BOT_URL=
