PAYDISK_SESSION_SECRET=change-me
PAYDISK_LIVE=false

# Approve یارانه → EXEC ListExporMarakez (BCP inside SP; path documented for ops)
PAYDISK_YARANE_DISKETTE_UNC=\\sqlcluster\MSSQLSERVER\Docs\Documents\Diskette
PAYDISK_ARMAGHAN_DISKETTE_BASE=http://10.1.0.17/Diskette
# PAYDISK_ARMAGHAN_TOKEN=
# PAYDISK_ARMAGHAN_COOKIE=

# Default DB when data/db-target.json is missing: prod | replica | test
# Must match Settings → Database; panel always prefers data/db-target.json
PAYDISK_DB_TARGET=prod

# Production host (155 has DB_Mostamary, not AmarDB)
PAYDISK_SQL_HOST=10.1.0.155
PAYDISK_SQL_PROD_DATABASE=DB_Mostamary
PAYDISK_SQL_DATABASE=AmarDB
PAYDISK_SQL_PORT=1433
PAYDISK_SQL_USER=
# Prefer base64 — plain passwords with $ / # are corrupted by Next env expansion
PAYDISK_SQL_PASSWORD_B64=
PAYDISK_SQL_PASSWORD=
PAYDISK_SQL_ENCRYPT=true
# Prod (155) often needs false — Tedious encrypt:true can "socket hang up"
PAYDISK_SQL_PROD_ENCRYPT=false
# PAYDISK_SQL_REPLICA_ENCRYPT=true
PAYDISK_SQL_TRUST_CERT=true

# Replication — always read-only in the panel (may use a different login)
PAYDISK_SQL_REPLICA_HOST=10.1.0.157
PAYDISK_SQL_REPLICA_DATABASE=AmarDB
# PAYDISK_SQL_REPLICA_USER=
# PAYDISK_SQL_REPLICA_PASSWORD_B64=

# Real writes on production 155 (create txn / Calculate* / Key2 Key3)
# Keep false until a write-capable SQL login is provided.
PAYDISK_HQ_WRITES=false
PAYDISK_SQL_WRITE_USER=
PAYDISK_SQL_WRITE_PASSWORD_B64=
# PAYDISK_SQL_WRITE_PASSWORD=

# Central Bank Sayah (NIX) — Sheba ↔ national-id match before Calculate
# PAYDISK_SAYAH_BASE_URL=https://gservices.nix.gov.ir
# PAYDISK_SAYAH_USER_KEY=
# PAYDISK_SAYAH_BUNDLE_ID=
# PAYDISK_SAYAH_USERNAME=
# PAYDISK_SAYAH_PASSWORD=

# Lab (Windows auth) — full write path for testing
PAYDISK_TEST_SQL_HOST=10.0.28.10
PAYDISK_TEST_SQL_DATABASE=DB_Mostamary
