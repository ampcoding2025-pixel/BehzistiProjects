PAYDISK_SESSION_SECRET=dev-local-change-me
PAYDISK_LIVE=false

# Approve یارانه → EXEC ListExporMarakez (BCP path is inside the SP)
# \\sqlcluster\MSSQLSERVER\Docs\Documents\Diskette\{Key2}
PAYDISK_YARANE_DISKETTE_UNC=\\sqlcluster\MSSQLSERVER\Docs\Documents\Diskette
# Optional Armaghan HTTP download base (UI link only)
PAYDISK_ARMAGHAN_DISKETTE_BASE=http://10.1.0.17/Diskette
# PAYDISK_ARMAGHAN_TOKEN=
# PAYDISK_ARMAGHAN_COOKIE=

# Default target if data/db-target.json is missing (prod | replica | test)
# Prefer switching from Settings → Database in the UI (admin).
PAYDISK_DB_TARGET=prod
# Legacy fallback (still honored when PAYDISK_DB_TARGET unset):
# PAYDISK_USE_TEST_DB=true

# Lab / test — Windows authentication
PAYDISK_TEST_SQL_HOST=10.0.28.10
PAYDISK_TEST_SQL_DATABASE=DB_Mostamary

# Production host (SQL login) — 10.1.0.155
# No AmarDB on this server; PayDisk schema is in DB_Mostamary
PAYDISK_SQL_HOST=10.1.0.155
PAYDISK_SQL_PROD_DATABASE=DB_Mostamary
PAYDISK_SQL_DATABASE=AmarDB
PAYDISK_SQL_PORT=1433
# alipoor2: db_datareader + db_datawriter on 155 (read+write)
PAYDISK_SQL_USER=alipoor2
# Prefer B64 — Next/@next/env expands $N and breaks passwords like …$2…
PAYDISK_SQL_PASSWORD_B64=IyQyNTQ2KDAxJSRVYQ==
# Legacy plaintext (kept empty on purpose; use B64 above)
PAYDISK_SQL_PASSWORD=
PAYDISK_SQL_ENCRYPT=true
# 155: encrypt:true → socket hang up (TLS); SSMS often connects without forcing encryption
PAYDISK_SQL_PROD_ENCRYPT=false
PAYDISK_SQL_TRUST_CERT=true

# Real writes on production 155 (create txn / Calculate* / Key2 Key3)
PAYDISK_HQ_WRITES=true
PAYDISK_SQL_WRITE_USER=behqlik
PAYDISK_SQL_WRITE_PASSWORD_B64=YkUjeiFzVHQxJCkwQ2whaWNL
PAYDISK_SQL_WRITE_PASSWORD=

# Replication — 10.1.0.157 (same alipoor2 login for read)
PAYDISK_SQL_REPLICA_HOST=10.1.0.157
PAYDISK_SQL_REPLICA_DATABASE=AmarDB
PAYDISK_SQL_REPLICA_USER=alipoor2
PAYDISK_SQL_REPLICA_PASSWORD_B64=IyQyNTQ2KDAxJSRVYQ==
