# Copy to .env.local

PAYDISK_SESSION_SECRET=replace-with-long-random-string
PAYDISK_LIVE=false

# true = use lab SQL (Windows auth, CRUD OK). false = AmarDB SQL login (read).
PAYDISK_USE_TEST_DB=true
PAYDISK_TEST_SQL_HOST=10.0.28.10
PAYDISK_TEST_SQL_DATABASE=DB_Mostamary
# Optional full ODBC string (overrides host/database above)
# PAYDISK_TEST_SQL_CONNECTION=Driver={ODBC Driver 18 for SQL Server};Server=10.0.28.10;Database=DB_Mostamary;Trusted_Connection=Yes;TrustServerCertificate=Yes;

# Production AmarDB (used when PAYDISK_USE_TEST_DB=false)
PAYDISK_SQL_HOST=10.1.0.157
PAYDISK_SQL_DATABASE=AmarDB
PAYDISK_SQL_PORT=1433
PAYDISK_SQL_USER=
# Quote value; escape $ as \$ so Next does not expand ($2, $HOME, etc.)
PAYDISK_SQL_PASSWORD='your-\$password'
PAYDISK_SQL_CONNECTION=
PAYDISK_SQL_ENCRYPT=true
PAYDISK_SQL_TRUST_CERT=true

# Approve یارانه → EXEC ListExporMarakez → BCP to this share (path is inside the SP)
PAYDISK_YARANE_DISKETTE_UNC=\\sqlcluster\MSSQLSERVER\Docs\Documents\Diskette
PAYDISK_ARMAGHAN_DISKETTE_BASE=http://10.1.0.17/Diskette
# PAYDISK_ARMAGHAN_TOKEN=
# PAYDISK_ARMAGHAN_COOKIE=
PAYDISK_ARMAGHAN_API=http://10.1.0.16/
